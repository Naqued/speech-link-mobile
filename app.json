{
  "expo": {
    "name": "Speech Link",
    "slug": "speech-link-mobile",
    "version": "1.4",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#4A6FEA"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "web": {
      "favicon": "./assets/favicon.png",
      "viewport": {
        "width": "device-width",
        "initialScale": 1,
        "maximumScale": 1,
        "userScalable": false,
        "viewportFit": "cover"
      }
    },
    "extra": {
      "eas": {
        "projectId": "6fc68554-48d3-4b26-a2a9-c4fae0ab35d0"
      }
    },
    "newArchEnabled": true,
    "scheme": "com.naqued.speechlinkmobile",
    "owner": "naqued",
    "android": {
      "package": "com.naqued.speechlinkmobile",
      "versionCode": 8,
      "permissions": [
        "INTERNET",
        "MODIFY_AUDIO_SETTINGS"
      ],
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "compileSdkVersion": 35,
      "targetSdkVersion": 35,
      "buildToolsVersion": "35.0.0",
      "manifest": {
        "application": {
          "android:supports16KbPages": true
        }
      }
    },
    "ios": {
      "bundleIdentifier": "com.naqued.speechlinkmobile",
      "supportsTablet": true
    },
    "cli": {
      "appVersionSource": "remote"
    },
    "plugins": [
      "./app.plugin.js",
      [
        "expo-build-properties",
        {
          "android": {
            "useNewNdkIntegration": true,
            "useLegacyPackaging": false,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "ndkVersion": "27.0.12077973"
          }
        }
      ]
    ],
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-audio-recorder-player",
          "react-native-fs",
          "react-native-sound",
          "@expo/metro-runtime",
          "i18next",
          "socket.io-client",
          "@naqued/speech-link-mobile"
        ],
        "listUnknownPackages": false
      }
    }
  }
}
